rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  AtithiBook — Firestore Security Rules
//  PASTE THESE IN: Firebase Console → Firestore Database → Rules → Publish
// ═══════════════════════════════════════════════════════════════════
//
//  ⚠️  READ THIS FIRST — WHAT THESE RULES CAN AND CANNOT DO
//
//  UPDATE (2026-09 audit): the ADMIN PANEL signs in with a server-minted
//  custom token (see isAdmin() below and netlify/functions/admin-auth.mjs).
//
//  UPDATE (AD-1 remediation, Phase 1 — see SECURITY_AUDIT.md): the HOTEL
//  APP (index.html) now ALSO gets a server-minted custom token —
//  {hotelId: <KEY>} — from /api/verify-access on every successful
//  license+phone check, and signs into it (HotelAuth module in
//  index.html). See `verifiedHotel()` below. THIS IS NOT YET ENFORCED:
//  the rules below accept EITHER that verified identity OR the bare
//  key-shape check, so every description in this note of what the
//  key-only model can and cannot do is STILL ACCURATE today — a device
//  that hasn't signed in (old cached build, Auth SDK blocked, etc.) is
//  still let in on key-shape alone. Phase 1 only gets verified identities
//  flowing so adoption can be observed (the `authVersion` doc each
//  hotel's data subtree gets once a device signs in) before Phase 2 (see
//  the TODO at the bottom of this file) removes the key-shape half of the
//  OR and makes `verifiedHotel()` the only way in. Until that flip
//  happens, every point below still applies in full.
//
//  The practical consequence, stated plainly: these rules CANNOT tell
//  "Hotel A's staff" apart from "a stranger on the internet who has
//  learned Hotel A's license key". Both arrive as the same anonymous
//  request. So the security these rules provide rests entirely on one
//  thing — the license key staying secret — which makes the key
//  effectively a password that is typed into a shared device, shown on
//  a setup screen, and never rotated.
//
//  What these rules DO achieve, and it is a very large improvement over
//  wide-open "test mode" rules:
//    1. They block ENUMERATION. Without `list` permission, an attacker
//       cannot ask "give me every hotel" or "give me every license".
//       Since license keys are cryptographically random (32^12 ≈ 1.15
//       × 10^18 possibilities), not being able to list them means not
//       being able to find them. This is the single biggest protection
//       here — with `list` allowed, one query would dump every hotel's
//       guest records on the platform.
//    2. They cap write sizes, so nobody can inflate a document to burn
//       through the project's storage/billing.
//    3. They block deletes on guest/booking records, so an attacker who
//       somehow obtained one key still cannot wipe that hotel's legally
//       required guest register.
//    4. They keep the public booking-request path write-only and small,
//       so the public link cannot be used to read anyone's data.
//
//  What they do NOT achieve — be clear-eyed about this:
//    • Anyone holding a valid license key can read and modify that
//      hotel's full guest data (names, phone numbers, addresses, masked
//      Aadhaar, stay history). That is Personal Data under the DPDP Act
//      2023, so treat a leaked key as a reportable data breach.
//    • A dishonest staff member who has seen the key retains access
//      after leaving, until the key is changed for that hotel.
//
//  PHASE 2 — THE REAL FIX — TODO once adoption is confirmed:
//    (a)–(c) already shipped: firebase-auth SDK in index.html,
//        /api/verify-access mints the custom token, HotelAuth.signIn()
//        calls signInWithCustomToken().
//    (d) REMAINING: once telemetry (the `authVersion` doc, or simply
//        enough elapsed time/support-ticket-free operation) shows every
//        live device has picked up a build with HotelAuth, remove the
//        `validHotelId(hotelId) ||` part from every hotels/ rule below,
//        leaving `verifiedHotel(hotelId) || isAdmin()` (keep isAdmin() —
//        the admin Data Manager depends on it). At that point a leaked key alone
//        stops being enough, and revoking a hotel's access for real means
//        revoking that uid's refresh tokens via the Admin API (in
//        addition to `active:false`).
//
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------

    // BizzSathi admin identity. The ONLY way to obtain it is the
    // /api/admin-auth Netlify function, which verifies ADMIN_PASSWORD
    // server-side (constant-time, rate-limited) and mints a Firebase
    // Custom Token with { admin: true } signed by the project's service
    // account. Custom claims cannot be set or forged by a client.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'bizzsathi-admin'
        && request.auth.token.admin == true;
    }

    // License keys are generated as ATITHI- followed by random
    // alphanumerics. Constraining the shape stops junk/probe documents
    // being created at arbitrary paths.
    function validHotelId(id) {
      return id is string
        && id.size() >= 8
        && id.size() <= 40
        && id.matches('^ATITHI-[A-Za-z0-9]+$');
    }

    // AD-1 REMEDIATION, PHASE 1 (see SECURITY_AUDIT.md). /api/verify-access
    // now mints a Firebase custom token — uid "hotel:<KEY>:<deviceId>",
    // claim {hotelId: <KEY>} — on every successful license+phone check, and
    // index.html's HotelAuth module signs into it. This helper recognizes
    // that VERIFIED identity, in addition to (not yet instead of) the
    // key-shape check below.
    //
    // Per the rule-semantics note further down: Firestore rules are OR'd, so
    // right now `validHotelId(hotelId) || verifiedHotel(hotelId)` behaves
    // identically to `validHotelId(hotelId)` alone — this does NOT tighten
    // anything yet, by design. It exists so devices can start signing in and
    // BizzSathi admin can watch adoption (the `authVersion` doc each hotel's
    // data subtree gets once a device signs in) before Phase 2 removes
    // `validHotelId(hotelId)` from these OR's and leaves only
    // `verifiedHotel(hotelId)` — the point at which a leaked license key
    // alone stops being sufficient to read or write that hotel's data.
    function verifiedHotel(id) {
      return request.auth != null
        && request.auth.token.hotelId == id;
    }

    // The admin panel's billing vault ID — a random per-admin-device
    // secret (see Billing.vault() in admin.html), NOT related to any
    // hotel's license key. "V" followed by 23 chars from a 32-symbol
    // alphabet.
    function validVaultId(id) {
      return id is string
        && id.size() == 24
        && id.matches('^V[A-Za-z0-9]+$');
    }

    // NOTE — there is deliberately NO byte-size guard in this file, and
    // that is not an oversight. Firestore Security Rules have no way to
    // check a document's byte size: `request.resource.size` is a CLOUD
    // STORAGE concept (the size of an uploaded file) and does not exist
    // on Firestore's `request.resource`. An earlier version of this file
    // called `request.resource.size()` believing it was a byte check.
    // That expression is INVALID in Firestore rules, an invalid
    // expression makes the rule ERROR, and Firestore treats an erroring
    // rule as DENY — so those rules were silently rejecting the very
    // writes they were meant to permit.
    //
    // What IS available is `request.resource.data.size()`, which returns
    // the NUMBER OF FIELDS (map keys), not bytes. That is a useful shape
    // check on small fixed-schema documents (used for the public paths
    // further down), but meaningless for the hotel data documents, which
    // are all shaped `{ value: <whole array>, ts: <number> }` and so
    // always have exactly 2 keys no matter how much data `value` holds.
    // Firestore's own hard 1 MiB per-document ceiling is the real
    // backstop against an oversized write, and it cannot be bypassed.

    // ---- per-hotel operational data ------------------------------
    // Path: hotels/{hotelId}/data/{docId}
    // docId is one of: rooms, bookings, profile, users, audit, cu,
    // permissions, creditNotes, authVersion, bookings_archive_YYYY_MM,
    // invCounter_YY-YY, cnCounter_YY-YY, menu (hotel's own menu),
    // rbills_YYYY_MM_DD (walk-in restaurant bills, one doc per day) and
    // rbCounter_YY-YY (restaurant bill number series).
    // (Public booking requests are NOT here — they live under the
    // separate, token-scoped public_booking/ tree; see below.)
    match /hotels/{hotelId}/data/{docId} {

      // `get` (one specific document) is allowed; `list` is NOT granted
      // to the hotel app or anyone anonymous. That distinction is
      // deliberate and is what prevents someone from enumerating hotels.
      // The staff app only ever does direct .doc(id).get() calls —
      // verified against the codebase — so denying list costs it nothing.
      //
      // ADMIN DATA MANAGER (admin.html → license card → "🗂️ Data"): the
      // authenticated BizzSathi admin (isAdmin(), server-minted claim) may
      // additionally LIST one hotel's data subcollection — so the manager
      // finds every document (including dated bookings_archive_* months)
      // without guessing ids — and may edit/delete. `isAdmin()` is OR'd in
      // explicitly (not relied on via validHotelId) so admin access keeps
      // working after AD-1 Phase 2 drops the key-shape check.
      allow get: if validHotelId(hotelId) || verifiedHotel(hotelId) || isAdmin();
      allow list: if isAdmin() && validHotelId(hotelId);

      // NOTE ON RULE SEMANTICS (worth remembering before adding any
      // narrower rule under this same path): Firestore Security Rules
      // are OR'd, not AND'd — per Google's own documentation, "if a
      // broad rule grants access to data, you can't restrict with a
      // more specific rule." So a tighter block added later for one
      // specific docId under here would be SILENTLY INEFFECTIVE, since
      // this wildcard would already have granted the access. If a path
      // under here ever needs stricter treatment, it must be excluded
      // from this block's conditions explicitly (or live outside this
      // subtree entirely, the way public_booking/ does).
      allow create, update: if validHotelId(hotelId) || verifiedHotel(hotelId) || isAdmin();

      // Guest registers are a legal retention requirement under the
      // Indian hospitality/police-reporting rules, and the app itself
      // never deletes these documents in normal operation — it only
      // overwrites them (archiving MOVES records between documents via
      // writes, never a delete). So the hotel app (anonymous or
      // verifiedHotel) still can NOT delete: a compromised or buggy hotel
      // device cannot destroy a hotel's records.
      //
      // Only the authenticated BizzSathi admin can delete, via the admin
      // Data Manager — which forces a full JSON backup download and a
      // typed-key confirmation before any delete (see dmDelete* in
      // admin.html). Used for closed/churned clients and DPDP erasure
      // requests.
      allow delete: if isAdmin();
    }

    // The app writes a few keys directly under the hotel document
    // itself rather than the data subcollection. Same treatment.
    match /hotels/{hotelId} {
      allow get: if validHotelId(hotelId) || verifiedHotel(hotelId) || isAdmin();
      allow create, update: if validHotelId(hotelId) || verifiedHotel(hotelId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- licenses (new, per-document storage) --------------------
    // `list` stays denied even for the admin: the panel discovers its
    // hotels through the admin_vault index (below), never a collection
    // scan, so a stolen admin session still cannot bulk-dump by query.
    //
    // HARDENED (audit 2026-09): this collection used to be world-readable
    // AND world-writable. Anyone could create "ATITHI-ANYTHING" with
    // plan PRO / active true and get free OCR billed to BizzSathi,
    // re-activate a revoked hotel, enable paid features, or overwrite the
    // registered phone (the verify-access second factor) with their own.
    // Reads leaked each hotel's registered phones and owner name.
    //
    // Now: only the authenticated admin reads/writes from a browser. The
    // Netlify functions (scan, verify-access, license-status) read with
    // the service account, which bypasses rules by design. The hotel app
    // gets its expiry/features via /api/license-status (no PII).
    match /licenses/{licenseKey} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin()
        && validHotelId(licenseKey)
        && request.resource.data.key == licenseKey
        && request.resource.data.size() <= 40;
      allow delete: if false;
    }

    // ---- legacy license storage ----------------------------------
    // The OLD single-array document that held EVERY hotel's license in
    // one place. One read of it leaks the entire customer list, so it
    // is the highest-value target in the database.
    //
    // Still read (server-side only) as a fallback for hotels not yet
    // migrated. Once every hotel is migrated, delete the document from
    // the Firebase console — nothing will need it.
    //
    // HARDENED (audit 2026-09): was `allow get: if true` + `allow create,
    // update: if true` — one anonymous GET dumped every customer, and one
    // anonymous PUT could inject a forged license (scan.mjs and
    // verify-access trusted this array) or wipe it (outage for every
    // not-yet-migrated hotel). Functions now read it via service account.
    match /admin/{docId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- public booking (token-scoped, safe to share) ------------
    // The public booking link is "…/?book=<PUBLIC-TOKEN>", where the
    // token is a random value UNRELATED to the hotel's license key, so
    // publishing the link never publishes the key.
    //
    // AUDIT-2 (F2) — WRITE OWNERSHIP. The token is deliberately public: it
    // is posted on Facebook/WhatsApp. The previous rules nonetheless let
    // anyone holding it UPDATE the page (`size() <= 12` was the only
    // check), so any stranger who saw the link could replace the hotel's
    // phone number with their own and take bookings/advance payments meant
    // for the hotel, and could LIST every pending enquiry (guest names and
    // phone numbers) and flip their status.
    //
    // Ownership is recorded ONCE, server-side-verifiable, in a private
    // binding document public_booking_owner/{token} = { hotelId, createdAt }:
    //   • no client can read it (rules' own get() is not subject to rules);
    //   • a hotel can create it only for a token whose public page does
    //     not exist yet, i.e. at the moment it mints a new link — so an
    //     existing page can never be claimed by someone else;
    //   • it can never be changed afterwards except by the admin (who also
    //     backfills bindings for pages created before this rule existed —
    //     see backfillBookingOwners() in admin.html).
    // The binding deliberately does NOT live in the hotel's own profile:
    // every hotel can write its own profile, so "my profile names this
    // token" proves nothing (independent review finding B1).
    function verifiedHotelId() {
      return request.auth != null
        && request.auth.token.hotelId is string
        && validHotelId(request.auth.token.hotelId);
    }
    function ownsBookingToken(token) {
      return verifiedHotelId()
        && exists(/databases/$(database)/documents/public_booking_owner/$(token))
        && get(/databases/$(database)/documents/public_booking_owner/$(token)).data.hotelId == request.auth.token.hotelId;
    }
    // Same check against the state AFTER the current batch, for the batch
    // that creates the binding and the page together.
    function ownsBookingTokenAfter(token) {
      return verifiedHotelId()
        && existsAfter(/databases/$(database)/documents/public_booking_owner/$(token))
        && getAfter(/databases/$(database)/documents/public_booking_owner/$(token)).data.hotelId == request.auth.token.hotelId;
    }
    // Shape of tokens minted by generatePublicBookingToken() in index.html.
    // Enforced on CREATE only, so pages published under any older token
    // format keep working for reads, updates and guest submissions.
    function validBookingToken(token) {
      return token is string && token.matches('^PB[A-Z2-9]{16}$');
    }
    function boundedString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    function validSnapshotFields(d) {
      return (!('hotelName' in d) || boundedString(d.hotelName, 200))
        && (!('hotelAddr' in d) || boundedString(d.hotelAddr, 1000))
        && (!('hotelPhone' in d) || boundedString(d.hotelPhone, 60))
        && (!('roomTypes' in d) || (d.roomTypes is list && d.roomTypes.size() <= 50))
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    // The hotel's outward-facing snapshot — name, address, phone, room
    // types and a "starting from" rate. World-readable by design (it is
    // what a hotel prints on its own website), not enumerable.
    match /public_booking/{token} {
      allow get: if true;
      allow list: if false;
      // CREATE: first publish of a brand-new random token, in the same
      // batch that creates its owner binding (see ownsBookingTokenAfter).
      allow create: if validBookingToken(token)
        && request.resource.data.keys().hasOnly(['hotelName', 'hotelAddr', 'hotelPhone', 'roomTypes', 'updatedAt'])
        && validSnapshotFields(request.resource.data)
        && (ownsBookingTokenAfter(token) || isAdmin());
      // UPDATE: only the owning hotel (or the admin). Only the published
      // snapshot fields may change; legacy extra fields may remain.
      allow update: if (ownsBookingToken(token) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hotelName', 'hotelAddr', 'hotelPhone', 'roomTypes', 'updatedAt'])
        && validSnapshotFields(request.resource.data);
      // Admin Data Manager only (removing a closed hotel's public page).
      allow delete: if isAdmin();
    }

    // Private owner binding for a public booking token (see the AUDIT-2 F2
    // note above). Never readable by clients; written once.
    match /public_booking_owner/{token} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['hotelId', 'createdAt'])
        && request.resource.data.createdAt is number
        && (
          (verifiedHotelId()
            && validBookingToken(token)
            && request.resource.data.hotelId == request.auth.token.hotelId
            && !exists(/databases/$(database)/documents/public_booking/$(token)))
          || (isAdmin() && validHotelId(request.resource.data.hotelId))
        );
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['hotelId', 'createdAt'])
        && validHotelId(request.resource.data.hotelId);
      allow delete: if isAdmin();
    }

    // Each booking request is its OWN document, created by the public page.
    match /public_booking/{token}/requests/{reqId} {
      // Guests submit without any identity — that is the feature. The
      // document must have exactly the public form's shape, start as
      // "pending", and its id field must equal its document id.
      allow create: if exists(/databases/$(database)/documents/public_booking/$(token))
        && reqId.matches('^REQ[A-Z0-9]{4,24}$')
        && request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'email', 'checkIn', 'checkOut', 'roomType', 'notes', 'status', 'createdAt'])
        && request.resource.data.id == reqId
        && request.resource.data.status == 'pending'
        && boundedString(request.resource.data.name, 100)
        && boundedString(request.resource.data.phone, 20)
        && (!('email' in request.resource.data) || boundedString(request.resource.data.email, 100))
        && (!('notes' in request.resource.data) || boundedString(request.resource.data.notes, 300))
        && (!('roomType' in request.resource.data) || boundedString(request.resource.data.roomType, 60))
        && (!('checkIn' in request.resource.data) || boundedString(request.resource.data.checkIn, 10))
        && (!('checkOut' in request.resource.data) || boundedString(request.resource.data.checkOut, 10))
        && (!('createdAt' in request.resource.data) || boundedString(request.resource.data.createdAt, 40));
      // AUDIT-2 (F2): enquiries contain guests' names and phone numbers —
      // readable only by the owning hotel and the admin, no longer by
      // anyone who has seen the public link.
      allow get, list: if ownsBookingToken(token) || isAdmin();
      // Staff accept/decline: only the decision fields may change.
      allow update: if (ownsBookingToken(token) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decisionReason'])
        && request.resource.data.status in ['pending', 'confirmed', 'declined']
        && (!('decisionReason' in request.resource.data) || boundedString(request.resource.data.decisionReason, 300))
        && (!('decidedAt' in request.resource.data) || boundedString(request.resource.data.decidedAt, 40));
      // Admin Data Manager only (clearing a closed hotel's enquiries).
      allow delete: if isAdmin();
    }

    // ---- BizzSathi admin billing (internal — NOT customer-facing) --
    // Path: billing/{vaultId}[/invoices/{id} | /clients/{key}]
    // vaultId is a random secret generated by the admin panel itself
    // (Billing.vault() in admin.html) — this data belongs to BizzSathi,
    // not to any hotel, and is entirely separate from the
    // hotels/{licenseKey}/** tree above. `list` is denied on all three
    // for the same enumeration reason as everywhere else in this file;
    // the admin panel only ever does direct .doc(id).get()/.collection()
    // .orderBy().limit() reads scoped to its OWN vaultId, so this costs
    // it nothing.
    //
    // HARDENED (audit 2026-09): the Vault ID is kept as the namespace, but
    // is no longer the ONLY credential — an authenticated admin session
    // is required as well (defence in depth: a leaked Vault ID alone no
    // longer exposes BizzSathi's invoices or client GSTINs).
    match /billing/{vaultId} {
      allow get: if isAdmin() && validVaultId(vaultId);
      allow list: if false;
      allow create, update: if isAdmin() && validVaultId(vaultId);
      allow delete: if false;
    }
    match /billing/{vaultId}/invoices/{invoiceId} {
      allow get, list: if isAdmin() && validVaultId(vaultId);
      // Issued invoices are immutable in the app's own logic (status can
      // move to paid/cancelled, but the number/amounts never change) —
      // rules don't re-derive GST math to enforce that server-side, so
      // this is app-level, not rules-level, discipline.
      allow create, update: if isAdmin() && validVaultId(vaultId);
      allow delete: if false;
    }
    match /billing/{vaultId}/clients/{clientKey} {
      allow get, list: if isAdmin() && validVaultId(vaultId);
      allow create, update: if isAdmin() && validVaultId(vaultId);
      allow delete: if false;
    }

    // ---- Admin Vault license index (internal — admin panel only) --
    // Path: admin_vault/{vaultId}  — ONE document: { licenseKeys: [...] }
    // Lets the admin panel load the real hotel list on any device without
    // opening `list` on licenses/ (which would let anyone dump every key).
    // vaultId is the same 24-char random secret the billing vault uses,
    // so this document is only reachable by someone who already holds it.
    // Holds keys only — each hotel's data is still read from its own
    // licenses/{key} document.
    match /admin_vault/{vaultId} {
      allow get: if isAdmin() && validVaultId(vaultId);
      allow list: if false;
      allow create, update: if isAdmin() && validVaultId(vaultId)
        && request.resource.data.keys().hasOnly(['licenseKeys', 'updatedAt']);
      allow delete: if false;
    }

    // ---- default deny --------------------------------------------
    // Anything not explicitly matched above is refused. New collections
    // added later start closed and must be opened deliberately, rather
    // than silently inheriting access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
